# Git LFS para assets binarios del proyecto 10b (GREED)
# Estos archivos se almacenan en LFS para no superar el límite de 100 MB de GitHub.
# Escenas de Unity
*.unity filter=lfs diff=lfs merge=lfs -text
# Materiales
*.mat filter=lfs diff=lfs merge=lfs -text
# Mallas y modelos
*.mesh filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.obj filter=lfs diff=lfs merge=lfs -text
# Texturas
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.tga filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text
*.exr filter=lfs diff=lfs merge=lfs -text
# Audio
*.ogg filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.aif filter=lfs diff=lfs merge=lfs -text
# Assets serializados de Unity
*.asset filter=lfs diff=lfs merge=lfs -text
*.cubemap filter=lfs diff=lfs merge=lfs -text
*.anim filter=lfs diff=lfs merge=lfs -text
*.controller filter=lfs diff=lfs merge=lfs -text
*.overrideController filter=lfs diff=lfs merge=lfs -text
# Bundles / recursos sin extensión en StreamingAssets
common filter=lfs diff=lfs merge=lfs -text
act-0 filter=lfs diff=lfs merge=lfs -text
act-1 filter=lfs diff=lfs merge=lfs -text
act-2 filter=lfs diff=lfs merge=lfs -text
prime filter=lfs diff=lfs merge=lfs -text
# Recursos serializados varios
*.data filter=lfs diff=lfs merge=lfs -text
*.resources filter=lfs diff=lfs merge=lfs -text
