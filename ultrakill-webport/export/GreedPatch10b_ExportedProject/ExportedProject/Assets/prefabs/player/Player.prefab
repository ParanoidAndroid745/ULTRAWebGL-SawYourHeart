  m_KeyboardText: "Enabling cheats means you will not gain a rank upon completion of a level and a Cyber Grind high score will not be saved.\n\n<color=green>Press <color=white>~</color> or <color=white>home</color> after enabling cheats to toggle the menu</color>"
  m_GenericText: "Enabling cheats means you will not gain a rank upon completion of a level and a Cyber Grind high score will not be saved.\n\n<color=green>Press <color=white>SELECT</color> and <color=white>RT</color> after enabling cheats to toggle the menu</color>"
  m_DualShockText: "Enabling cheats means you will not gain a rank upon completion of a level and a Cyber Grind high score will not be saved.\n\n<color=green>Press <color=white>SHARE</color> and <color=white>R2</color> after enabling cheats to toggle the menu</color>"
